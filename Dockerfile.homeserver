# Sound It Platform - Home Server Dockerfile
# Robust Alpine-based image for home server deployment

FROM python:3.11-alpine

# Install build dependencies and runtime packages
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    postgresql-dev \
    jpeg-dev \
    zlib-dev \
    libpng-dev \
    freetype-dev \
    curl \
    libpq \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .

# Try installing requirements; if psycopg2-binary fails on Alpine,
# swap it for psycopg2 (source build) and retry
RUN pip3 install --no-cache-dir -r requirements.txt || \
    (sed -i 's/psycopg2-binary/psycopg2/g' requirements.txt && \
     pip3 install --no-cache-dir -r requirements.txt) || \
    pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application code (includes built frontend in app/dist/)
COPY . .

# Create required directories
RUN mkdir -p uploads logs static

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python3", "-m", "uvicorn", "main_production:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
