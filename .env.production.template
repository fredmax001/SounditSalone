ENVIRONMENT=production
DEBUG=false
DEVELOPER_MODE=false
APP_NAME=Sound It API
SECRET_KEY=CHANGE_ME_TO_64_CHARACTER_RANDOM_STRING_MINIMUM_LENGTH_REQUIRED_HERE
BASE_URL=https://api.sounditsl.com
FRONTEND_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://soundit_user:STRONG_PASSWORD@localhost:5432/soundit_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_URL=redis://localhost:6379/1
CORS_ORIGINS=https://sounditsl.com,https://www.sounditsl.com,https://app.sounditsl.com
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=soundit-uploads-prod
AWS_REGION=eu-west-1
AWS_CLOUDFRONT_URL=https://cdn.sounditsl.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@sounditsl.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_FROM_NAME=Sound It
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+232XXXXXXXX
TWILIO_VERIFY_SERVICE_SID=VA_your_verify_service_sid
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FILE=/var/log/soundit/app.log
MAX_UPLOAD_SIZE=10485760
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_SMS_OTP=true
ENABLE_EMAIL_OTP=true

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.sounditsl.com/api/v1/auth/google/callback

# Kimi AI Settings
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.kimi.com/coding/v1

# Default Admin Account (used only on first DB initialization)
# Set this to create the initial super admin. Leave empty to skip auto-creation.
DEFAULT_ADMIN_EMAIL=admin@soundit.com
DEFAULT_ADMIN_PASSWORD=your-secure-random-password
